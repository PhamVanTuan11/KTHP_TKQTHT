<%- include('partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">🍽️ Quản lý Thực đơn & Món ăn</h1>
    <p class="page-subtitle">Quản lý danh mục món khai vị, món chính, lẩu & nướng, đồ uống và tráng miệng của nhà hàng.</p>
  </div>
</div>

<% if (flash) { %>
  <div class="alert alert-success">✅ <%= flash %></div>
<% } %>
<% if (error) { %>
  <div class="alert alert-error">⚠️ <%= error %></div>
<% } %>

<div class="card">
  <div class="card-header">
    <h2 class="card-title">➕ Thêm món ăn mới vào thực đơn</h2>
  </div>
  <form method="POST" action="/menu" class="form-grid">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="form-group">
      <label for="code">Mã món *</label>
      <input type="text" id="code" name="code" required placeholder="VD: MN-009" />
    </div>
    <div class="form-group">
      <label for="name">Tên món ăn *</label>
      <input type="text" id="name" name="name" required placeholder="VD: Tôm hùm nướng phô mai" />
    </div>
    <div class="form-group">
      <label for="category">Danh mục *</label>
      <select id="category" name="category" required>
        <% categories.forEach(c => { %>
          <option value="<%= c %>"><%= c %></option>
        <% }) %>
      </select>
    </div>
    <div class="form-group">
      <label for="price">Đơn giá (VNĐ) *</label>
      <input type="number" id="price" name="price" min="0" step="1000" required placeholder="150000" />
    </div>
    <div class="form-group">
      <label for="unit">Đơn vị tính</label>
      <input type="text" id="unit" name="unit" value="Phần" />
    </div>
    <div class="form-group">
      <label for="description">Mô tả nguyên liệu / chế biến</label>
      <input type="text" id="description" name="description" placeholder="Mô tả ngắn gọn món ăn..." />
    </div>
    <div class="form-group">
      <button type="submit" class="btn btn-primary">+ Lưu món ăn</button>
    </div>
  </form>
</div>

<div class="card">
  <div class="card-header">
    <h2 class="card-title">📖 Danh mục món ăn hiện có (<%= items.length %> món)</h2>
    <form method="GET" action="/menu" class="inline-actions">
      <input type="text" name="q" value="<%= filters.q %>" placeholder="Tìm tên hoặc mã món..." />
      <select name="category">
        <option value="">-- Tất cả danh mục --</option>
        <% categories.forEach(c => { %>
          <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option>
        <% }) %>
      </select>
      <select name="availability">
        <option value="">-- Mọi trạng thái --</option>
        <option value="available" <%= filters.availability === 'available' ? 'selected' : '' %>>Còn món</option>
        <option value="unavailable" <%= filters.availability === 'unavailable' ? 'selected' : '' %>>Tạm hết</option>
      </select>
      <button type="submit" class="btn btn-secondary btn-sm">Lọc</button>
      <a href="/menu" class="btn btn-secondary btn-sm">Xóa lọc</a>
    </form>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Mã món</th>
          <th>Tên món ăn & Mô tả</th>
          <th>Danh mục</th>
          <th>Đơn vị</th>
          <th>Đơn giá</th>
          <th>Trạng thái</th>
          <th>Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(item => { %>
          <tr>
            <td><strong><%= item.code %></strong></td>
            <td>
              <strong><%= item.name %></strong><br />
              <span style="font-size:12px; color:var(--muted);"><%= item.description %></span>
            </td>
            <td><span class="badge badge-info"><%= item.category %></span></td>
            <td><%= item.unit %></td>
            <td><strong><%= formatVND(item.price) %></strong></td>
            <td>
              <% if (item.is_available) { %>
                <span class="badge badge-success">Còn phục vụ</span>
              <% } else { %>
                <span class="badge badge-danger">Tạm hết</span>
              <% } %>
            </td>
            <td>
              <div class="inline-actions">
                <form method="POST" action="/menu/<%= item.id %>/toggle" style="display:inline;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit" class="btn btn-secondary btn-sm">
                    <%= item.is_available ? 'Báo hết' : 'Mở bán' %>
                  </button>
                </form>
                <form method="POST" action="/menu/<%= item.id %>/delete" style="display:inline;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
