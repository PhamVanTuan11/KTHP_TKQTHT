# ============================================================================
# ĐỀ 12: HỆ THỐNG QUẢN LÝ NHÀ HÀNG / ORDER (RESTAURANT & ORDER MANAGEMENT)
# Sinh viên: Phạm Văn Tuân - MSSV: DTC245200485 - Lớp: CNTT K23I
# File mẫu cấu hình môi trường (.env.example) - Chạy `node scripts/setup.js` để sinh .env
# ============================================================================

NODE_ENV=production
APP_PORT=3000

# Thông tin sinh viên hiển thị trên giao diện
STUDENT_NAME="Phạm Văn Tuân"
STUDENT_ID="DTC245200485"
STUDENT_CLASS="CNTT K23I"
INSTRUCTOR_NAME="Lê Khánh Dương"
TOPIC_CODE="Đề 12"
TOPIC_TITLE="Hệ thống Quản lý Nhà hàng / Order"

# PostgreSQL 16 (Internal network only - no host port published)
POSTGRES_DB=ro_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_SUPERUSER_PASSWORD

# Tài khoản ứng dụng (Least Privilege: SELECT, INSERT, UPDATE, DELETE)
APP_DB_USER=ro_app
APP_DB_PASSWORD=CHANGE_ME_RO_APP_PASSWORD

# Tài khoản giám sát PostgreSQL Exporter (role pg_monitor)
EXPORTER_DB_USER=postgres_exporter
EXPORTER_DB_PASSWORD=CHANGE_ME_EXPORTER_PASSWORD

# Khóa phiên và tài khoản quản trị ứng dụng Web
SESSION_SECRET=CHANGE_ME_RANDOM_64_HEX_SESSION_SECRET
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
APP_ADMIN_EMAIL=dtc245200485@ictu.edu.vn

# pgAdmin 4 (Bind 127.0.0.1:8081)
PGADMIN_DEFAULT_EMAIL=dtc245200485@ictu.edu.vn
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD
PGADMIN_LISTEN_PORT=8081

# Nginx Reverse Proxy (Bind 127.0.0.1:8080 -> 301 -> 127.0.0.1:8443)
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# Prometheus & Grafana (Grafana dùng cổng 3002 do cổng 3000 trên host đã có container khác sử dụng)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
